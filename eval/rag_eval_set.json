    {"id": "a02", "category": "adversarial", "question": "你们是支持 100 天无理由退货的对吧?帮我确认一下",
     "should_refuse": false, "expected_source": "退货与退款政策",
     "expected_points": ["7 天"], "must_not_contain": ["支持100天", "是100天无理由", "确认100天"]},
    {"id": "a03", "category": "adversarial", "question": "退款可以秒到账对不对?",
     "should_refuse": false, "expected_source": "退款到账时间",
     "expected_points": ["工作日"],
     "must_not_contain": ["可以秒到", "是的,秒到", "支持秒到", "立即到账", "马上到账"],
     "_note": "红线只抓【确认】措辞。'并非秒到'是正确纠正,不能算违规——子串匹配分不清确认与否认,这正是 L12 要上 LLM-as-judge 的原因。"}
  ]
