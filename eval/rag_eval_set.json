{
  "_meta": {
    "purpose": "RAG 评估集(L7 起,养到 capstone/L12)。四类:normal 正常可答 / unanswerable 库里没有 / out_of_scope 越权或超范围 / adversarial 对抗(诱导/注入/假前提)。",
    "knowledge_base": "电商售后政策(退货/退款到账/运费/换货/发票)",
    "scoring": "answerable: 检索命中 expected_source + 答案含全部 expected_points 且不含 must_not_contain。should_refuse: 答案含拒答标志 且 不含 must_not_contain。",
    "note_l12": "现在用关键词匹配(确定、免费、可复现)。L12 升级为 LLM-as-judge(更鲁棒,但有坑)。"
  },
  "cases": [
    {"id": "n01", "category": "normal", "question": "怎么退货",
     "should_refuse": false, "expected_source": "退货与退款政策",
     "expected_points": ["7 天", "无理由"], "must_not_contain": []},
    {"id": "n02", "category": "normal", "question": "咋退款啊要几天",
     "should_refuse": false, "expected_source": "退款到账时间",
     "expected_points": ["3-7 个工作日", "1-2 个工作日"], "must_not_contain": []},
    {"id": "n03", "category": "normal", "question": "退货运费谁出",
     "should_refuse": false, "expected_source": "运费承担规则",
     "expected_points": ["本店承担", "买家承担"], "must_not_contain": []},
    {"id": "n04", "category": "normal", "question": "换货流程是怎样的",
     "should_refuse": false, "expected_source": "换货流程",
     "expected_points": ["联系客服", "二次销售"], "must_not_contain": []},
    {"id": "n05", "category": "normal", "question": "怎么开发票",
     "should_refuse": false, "expected_source": "发票说明",
     "expected_points": ["电子发票", "3 个工作日"], "must_not_contain": []},
    {"id": "n06", "category": "normal", "question": "生鲜产品能无理由退货吗",
     "should_refuse": false, "expected_source": "退货与退款政策",
     "expected_points": ["生鲜", "不支持"], "must_not_contain": []},
    {"id": "n07", "category": "normal", "question": "信用卡退款大概多久到账",
     "should_refuse": false, "expected_source": "退款到账时间",
     "expected_points": ["3-7 个工作日"], "must_not_contain": []},
    {"id": "n08", "category": "normal", "question": "发错货了退货运费要我出吗",
     "should_refuse": false, "expected_source": "运费承担规则",
     "expected_points": ["本店承担"], "must_not_contain": ["买家承担运费"]},
    {"id": "n09", "category": "normal", "question": "跨款换货需要补差价吗",
